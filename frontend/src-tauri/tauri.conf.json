{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataForge Analytics",
  "version": "1.0.0",
  "identifier": "com.dataforge.analytics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop && cross-env TAURI_BUILD=1 NEXT_PUBLIC_APP_VERSION=1.0.0 npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "DataForge Analytics",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:* http://localhost:3000 http://tauri.localhost https://tauri.localhost http://asset.localhost https://asset.localhost; connect-src 'self' http://127.0.0.1:* http://localhost:* http://localhost:3000 http://tauri.localhost https://tauri.localhost http://asset.localhost https://asset.localhost ws://localhost:3000"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../../build/backend-pack"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
